{
  "name": "@anicotto/utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./classname": {
      "types": "./dist/classname.d.mts",
      "import": "./dist/classname.mjs"
    },
    "./result": {
      "types": "./dist/result.d.mts",
      "import": "./dist/result.mjs"
    },
    "./normalize": {
      "types": "./dist/normalize.d.mts",
      "import": "./dist/normalize.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anicotto/tsconfig": "workspace:*",
    "tailwind-merge": "^3.4.1",
    "tailwind-variants": "^3.2.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.0.18"
  }
}
