{
  "name": "@anicotto/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "generate:cf-types": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply anicotto --local",
    "db:migrate:remote": "wrangler d1 migrations apply anicotto --remote",
    "db:studio:remote": "drizzle-kit studio --config ./drizzle.remote.config.ts",
    "db:studio:local": "drizzle-kit studio"
  },
  "dependencies": {
    "@anicotto/annict-rest-client": "workspace:*",
    "@anicotto/domain": "workspace:*",
    "@anicotto/utils": "workspace:*",
    "@hono/standard-validator": "^0.2.2",
    "@kawaiioverflow/arm": "^0.228.0",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.10",
    "ts-pattern": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@anicotto/tsconfig": "workspace:*",
    "@libsql/client": "^0.17.0",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.9",
    "typescript": "catalog:",
    "wrangler": "^4.66.0"
  }
}
